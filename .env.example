
# Firebase Project Configuration
# Copy these into a .env.local file and replace with your actual Firebase project credentials.
NEXT_PUBLIC_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
# NEXT_PUBLIC_FIREBASE_DATABASE_URL="YOUR_FIREBASE_DATABASE_URL" # Not strictly needed for Firestore only
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id" # Replace with your actual Project ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
NEXT_PUBLIC_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# Admin password for the /admin route
NEXT_PUBLIC_ADMIN_PASSWORD="1234"


# MinIO Configuration (if switching from Firebase Storage)
# Ensure these are set in your .env.local file if you intend to use MinIO
# NEXT_PUBLIC_MINIO_ENDPOINT="http://your-minio-server-ip-or-domain:port" # e.g., http://129.146.81.205:9005
# NEXT_PUBLIC_MINIO_ACCESS_KEY_ID="your_minio_access_key"                 # e.g., mediaremote
# NEXT_PUBLIC_MINIO_SECRET_ACCESS_KEY="your_minio_secret_key"             # e.g., QAi19KIv4W4W5y
# NEXT_PUBLIC_MINIO_BUCKET_NAME="your_minio_bucket_name"                  # e.g., dashboardify
# NEXT_PUBLIC_MINIO_USE_SSL="false"                                       # Set to "true" if your MinIO endpoint uses HTTPS
# NEXT_PUBLIC_MINIO_REGION="us-east-1"                                    # Default region, usually fine for MinIO

